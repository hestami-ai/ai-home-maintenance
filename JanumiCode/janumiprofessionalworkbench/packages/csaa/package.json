{
	"name": "@janumipwb/csaa",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Deterministic code-semantic analysis and assurance tooling for JPWB.",
	"license": "AGPL-3.0-only",
	"bin": {
		"csaa-coding-agent": "./dist/cli/csaa-coding-agent-bin.js"
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"dependencies": {
		"ajv": "8.20.0",
		"svelte": "5.56.4",
		"svelte2tsx": "0.7.57",
		"typescript": "5.9.3"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit -p tsconfig.json",
		"dependency-cruiser-differential": "bun ../../scripts/csaa-dependency-cruiser-differential.ts --write",
		"dependency-cruiser-differential:check": "bun ../../scripts/csaa-dependency-cruiser-differential.ts --check",
		"dependency-cruiser-g4": "bun ../../scripts/csaa-dependency-cruiser-differential.ts --g4-write",
		"dependency-cruiser-g4:check": "bun ../../scripts/csaa-dependency-cruiser-differential.ts --g4-check",
		"dependency-cruiser-g4:json": "bun ../../scripts/csaa-dependency-cruiser-differential.ts --g4-json",
		"persistence-selection": "bun src/persistence/run-dwp-007-persistence-selection.ts --write",
		"persistence-selection:check": "bun src/persistence/run-dwp-007-persistence-selection.ts --check"
	},
	"devDependencies": {
		"@janumipwb/typescript-config": "workspace:*"
	}
}
